# Supabase (replaces PostgreSQL + Docker)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage bucket for photo uploads (create in Supabase dashboard)
SUPABASE_STORAGE_BUCKET=ancestry-photos
SUPABASE_UPLOAD_URL_TTL_SECONDS=300
MAX_PHOTO_UPLOAD_BYTES=8388608

# Yoco payments
YOCO_SECRET_KEY=sk_live_...
YOCO_WEBHOOK_SECRET=whsec_...
YOCO_WEBHOOK_TOLERANCE_SECONDS=180
FULL_REPORT_ENTITLEMENT_KEY=ancestry_full_report
FULL_REPORT_AMOUNT_CENTS=29900
PAYMENT_CURRENCY=ZAR

# Resend email (resend.com — free tier: 3k emails/month)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Africa Ancestry <reports@yourdomain.com>

# App
PORT=3000
APP_BASE_URL=https://your-frontend-domain.com
CORS_ORIGIN=https://your-frontend-domain.com
